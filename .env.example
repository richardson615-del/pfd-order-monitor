# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# ---------------------------------------------------------------------------
# Google Cloud OAuth client (for Gmail API access) - see README "Gmail API setup"
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Must exactly match a redirect URI configured in the Google Cloud OAuth client
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback/google

# ---------------------------------------------------------------------------
# Web Push (VAPID keys) - generate with: npm run gen:vapid
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxx
VAPID_CONTACT_EMAIL=support@pfdworks.com

# ---------------------------------------------------------------------------
# Cron protection - Vercel automatically sends this as a Bearer token when it
# calls scheduled routes, as long as this env var is named exactly CRON_SECRET.
# Generate any random string, e.g.: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=xxxxxxxx

# ---------------------------------------------------------------------------
# Zuppler webhook (order ingestion). Generate the token YOURSELF
# (openssl rand -hex 32), set it here/in Vercel, and share it with Zuppler
# (Jerry). They send it verbatim in the Authorization header of the webhook.
# ---------------------------------------------------------------------------
ZUPPLER_WEBHOOK_SECRET=xxxxxxxx

# Zuppler money units in their GraphQL responses: 'cents' (default) or
# 'dollars'. CONFIRMED cents against a real order (f9212833): the API
# returned total=8434 for an $84.34 receipt, and subtotal+tax+service+
# delivery+tip == total, so the total includes the tip. Leave this alone
# unless Zuppler changes format - 'dollars' would print every figure 100x
# too large on a ticket that otherwise looks completely normal.
ZUPPLER_AMOUNTS=cents
