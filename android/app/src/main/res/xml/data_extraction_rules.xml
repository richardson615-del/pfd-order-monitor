<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for allowBackup/fullBackupContent, which older
  versions read instead. All three are set, so every Android version this app
  supports refuses to copy the app's data off the device.

  What is being protected: the signed-in restaurant session living in the
  wrapper's storage. These tablets sit switched on in a public-facing room and
  sign in once, so a backup of that session is of no use to the restaurant and
  of obvious use to anybody else.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
